# ---- Database (required) ----
# Local: npm run db:local  →  postgres://postgres@127.0.0.1:54329/lms
# Supabase: Project Settings → Database → Connection string (Session pooler, port 5432).
DATABASE_URL=postgres://postgres@127.0.0.1:54329/lms

# Public URL of the app (used in emails and auth redirects).
APP_URL=http://localhost:3000

# ---- Supabase Auth + Storage (production) ----
# Without these, the app runs in dev-login mode (seed users, never in production).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for uploads (private bucket) and deleting auth users.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private

# Signs the dev-login cookie. Generate: openssl rand -hex 32
AUTH_SECRET=

# ---- Video (Bunny Stream) ----
BUNNY_LIBRARY_ID=
# Library → Security → Embed view token authentication key
BUNNY_TOKEN_KEY=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="Learning <noreply@example.com>"

# ---- Payments webhook ----
# HMAC-SHA256 secret shared with the payment provider / automation. Generate: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=
